{
  "name": "rec-soft",
  "version": "1.0.1",
  "description": "軽量なWindows 11向け画面録画ソフト",
  "main": "src/main.js",
  "author": "Raft3921",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dir"
  },
  "dependencies": { "electron-updater": "^6.6.2", "ffmpeg-static": "^5.2.0" },
  "devDependencies": { "electron": "^37.2.6", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "jp.raft.recsoft",
    "productName": "REC soft",
    "asar": true,
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "files": ["src/**/*", "package.json", "node_modules/ffmpeg-static/**/*"],
    "directories": { "output": "dist" },
    "publish": [{ "provider": "github", "owner": "Raft3921", "repo": "REC-soft" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "REC soft", "artifactName": "REC-soft-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "REC-soft-Portable-${version}-${arch}.${ext}" },
    "mac": { "target": "dir", "category": "public.app-category.video" }
  }
}
