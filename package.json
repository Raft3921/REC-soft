{
  "name": "rec-soft",
  "version": "1.0.9",
  "description": "軽量なWindows 11向け画面録画ソフト",
  "main": "src/main.js",
  "author": "Raft3921",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.raft.recsoft",
    "productName": "REC soft",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "!**/*.map",
      "!**/{test,tests,__tests__}/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Raft3921",
        "repo": "REC-soft"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "REC soft",
      "artifactName": "REC-soft-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "REC-soft-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.icns",
      "artifactName": "REC-soft-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "USBキャプチャーボードなどの映像を録画するために使用します。",
        "NSScreenCaptureUsageDescription": "画面またはウィンドウを動画として録画するために使用します。",
        "NSAudioCaptureUsageDescription": "Macで再生されている音声を録画するために使用します。",
        "NSMicrophoneUsageDescription": "マイク音声を動画に録音するために使用します。"
      }
    }
  }
}
